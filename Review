public class ShortEnquiryService_Child {
	
	Logger logger = LoggerFactory.getLogger(ShortEnquiryService_Child.class);
	
	
	public List<String> callShortEnquiryChild(String accno, String opcode, String tellerno, String branchno, String recarea,String refno, DataSource datasource) throws InterruptedException, ExecutionException, SQLException {
		
		String errno = new String();
		String outres = new String();
		List<String> resList = new ArrayList<>();
		
		String formattedTeller = tellerno.length() >= 7 ? tellerno.substring(tellerno.length() - 7) : tellerno;
		
		JVM400					jvm400			=	new JVM400();
		Ls400AccountNumber		acctnumber		=	new Ls400AccountNumber();
		Ls400OptionCode			optioncode		=   new Ls400OptionCode();
		LsErrorNumber			errornumber		=	new LsErrorNumber();
		LsRecordArea			lsrecordarea	=	new	LsRecordArea();
		LsTellerNumber			tellernum		=	new	LsTellerNumber();
		LsBranchNumber			branchnum		=	new LsBranchNumber();
		Ls400Opt1Output         out_response    =	new Ls400Opt1Output();
		logger.info("VC------------------------ShortEnquiryService_Child Service Started------------------------VC" + refno);
		
		acctnumber.setLs400AccountNumber(StringUtils.leftPad(accno, 17, "0"));
		optioncode.setLs400OptionCode(opcode);
		tellernum.setLsTellerNumber(formattedTeller);
		branchnum.setLsBranchNumber(branchno);
		lsrecordarea.setLsRecordArea(recarea);
		
		 RunUnit run1 = new RunUnit();
		 logger.info("VC------------------------Initiating DB Pooling------------------------VC " + refno);
		 try (Connection connection = datasource.getConnection()){
			 
				
	            run1.Add(jvm400);
	    		run1.Call("JVM400", acctnumber.get_Reference(),
	    				optioncode.get_Reference(),
	    				tellernum.get_Reference(),
	    				branchnum.get_Reference(),
	    				out_response.get_Reference(),
	    				errornumber.get_Reference(),
	    				lsrecordarea.get_Reference(),
	    				connection
	    				);
	    		
	    	errno = errornumber.getLsErrorNumber();
	    	outres = out_response.getLs400Opt1Output();
		
	    	run1.close();
	    	resList.add(outres);
	    	resList.add(errno);
		
		return resList;
	}

}
