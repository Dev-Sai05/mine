	private static final boolean customFilter(String input) {

		String reg = "!~`#%&;*<>=@$()+/?^|";
		String str = input;
		for (int i = 0; i < reg.length(); i++) {
			if (str.contains(reg.charAt(i) + "") && !(input.length() < 50000)) {
				filterFlag = false;
			} else {
				filterFlag = true;
			}
		}

		return filterFlag;

