package com.tcs.bancs.microservices.services;

import java.util.ArrayList;
import java.util.List;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Service;

import com.tcs.bancs.microservices.db.model.Sysc;
import com.tcs.bancs.microservices.repository.night.SyscDetailNightRepo;

@Service
public class SyscScheduler {
	Logger LOGGER = LoggerFactory.getLogger(SyscScheduler.class);
	@Autowired
	SyscDetailNightRepo syscReponight;
	
	public volatile boolean NightEnabled;
	public volatile boolean NightDay;
	public volatile boolean NightRef;

	public boolean isNightEnabled() {
		return NightEnabled;
	}

	public void setNightEnabled(boolean nightEnabled) {
		NightEnabled = nightEnabled;
	}

	public boolean isNightDay() {
		return NightDay;
	}

	public void setNightDay(boolean nightDay) {
		NightDay = nightDay;
	}

	public boolean isNightRef() {
		return NightRef;
	}

	public void setNightRef(boolean nightRef) {
		NightRef = nightRef;
	}

	//@Scheduled(fixedDelay = 1000)
	public void refreshSysc() {

		List<Sysc> syscRes = new ArrayList<Sysc>();
		syscRes = syscReponight.findBySyscDetail();
		if (syscRes.get(0).getSyscVariable().substring(10, 11).equals("D")) {
			NightEnabled = false;
			NightRef = false;
			NightDay = false;
			LOGGER.info("Data Fetch from Day DB");
		} else if (syscRes.get(0).getSyscVariable().substring(10, 11).equals("N")
				&& syscRes.get(0).getSyscVariable().substring(74, 75).equals("r")) {
			NightEnabled = true;
			NightRef = true;
			NightDay = false;
			LOGGER.info("Data Fetch from night/Ref DB");
		} else if (syscRes.get(0).getSyscVariable().substring(10, 11).equals("N")) {
			NightEnabled = true;
			NightDay = true;
			NightRef = false;
			LOGGER.info("Data Fetch from night/Day DB after");
		}
	}

}




